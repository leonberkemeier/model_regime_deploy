# ============================================================
# Quant-Agent Advisor — AI PC Node Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit your actual .env to version control.
# ============================================================


# ── Network ──────────────────────────────────────────────────
# Tailscale MagicDNS hostname or IP of the always-on webserver.
WEBSERVER_URL=http://your-server.tailnet.ts.net:9875

# URL of the local Ollama instance (usually localhost on AI PC).
OLLAMA_HOST=http://localhost:11434
OLLAMA_URL=http://localhost:11434


# ── Ollama / LLM ─────────────────────────────────────────────
# Model to use for conviction scoring and realignment.
# Must be pulled first: ollama pull <model>
# Fast option: deepseek-r1:1.5b | Best quality: gemma3:12b
OLLAMA_MODEL=deepseek-r1:1.5b

# Timeout in seconds per Ollama call. Raise for larger models.
OLLAMA_TIMEOUT=180


# ── LLM Pipeline ─────────────────────────────────────────────
# Top N candidates passed to LLM after Calmar pre-filter.
# Held tickers are always added on top of this number.
LLM_TOP_N_CANDIDATES=25

# Enable ReAct agentic loop (requires MCP server running).
# Falls back to single-shot automatically if server is unreachable.
LLM_AGENTIC_MODE=false

# Max tool-call iterations per ticker in agentic mode.
AGENT_MAX_ITERS=5

# Confidence gate: scores below this are BLOCKED and not saved.
AGENT_CONFIDENCE_THRESHOLD=0.80


# ── MCP Server ───────────────────────────────────────────────
# AI PC connects to this URL to call MCP tools (agentic mode only).
MCP_SERVER_URL=http://your-server.tailnet.ts.net:9876

# Host/port the MCP server listens on (set on the SERVER side).
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=9876


# ── Databases ────────────────────────────────────────────────
# Local SQLite DB for HMM regimes + Monte Carlo results.
REGIMES_DB_PATH=./regimes.db

# Main financial database (dim_company, fact_sentiment, macro data).
# AI PC uses a local copy; server uses the primary.
FINANCIAL_DB_PATH=./financial_data.db


# ── ChromaDB / Vector Store ───────────────────────────────────
# Where ChromaDB stores its data. Use a stable path on the server.
CHROMA_DB_PATH=./chroma_db

# Sentence embedding model (~90MB, downloaded automatically on first run).
EMBEDDING_MODEL=all-MiniLM-L6-v2


# ── SEC EDGAR ─────────────────────────────────────────────────
# REQUIRED — SEC blocks requests without a valid User-Agent.
# Format: "AppName your@email.com"
EDGAR_USER_AGENT=QuantAdvisor your@email.com

# Seconds between EDGAR requests. 0.15 keeps well within 10 req/sec limit.
EDGAR_RATE_DELAY=0.15

# Max characters per 10-K section extracted (~15000 ≈ 3000 tokens).
MAX_SECTION_CHARS=15000

# Recent filings to ingest per ticker (10-K + 10-Q).
FILINGS_PER_TICKER=4


# ── Monte Carlo (GARCH) ───────────────────────────────────────
# Set false to revert to plain Gaussian simulation (debug only).
MC_USE_GARCH=true

# Fallback GARCH(1,1) params used when per-ticker fitting fails.
# alpha + beta MUST be < 1.0 to maintain variance stationarity.
GARCH_ALPHA=0.09
GARCH_BETA=0.90


# ── Realignment Thresholds ────────────────────────────────────
# ES_95 must worsen by this fraction vs snapshot → RISK violation.
REALIGN_RISK_DECAY=0.50

# Conviction floor — below this triggers CONVICTION_DROP exit.
REALIGN_CONVICTION_FLOOR=-0.30

# Challenger must exceed held average by this → OPPORTUNITY swap.
REALIGN_OPPORTUNITY_GAP=0.30

# Fraction of held tickers with hard violations needed to trigger rebuild.
REALIGN_REBUILD_RATIO=0.30


# ── Daily Scheduler ──────────────────────────────────────────
# Hour (24h) and minute the daily pipeline starts.
WORK_HOUR=8
WORK_MINUTE_MARKOV=5
WORK_MINUTE_MC=30
WORK_MINUTE_LLM=0
WORK_MINUTE_TRIGGER=30
